---
import { getCvUrl, getCvFilename } from '../data/cv';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  variant?: 'primary' | 'outline';
  class?: string;
}

const { locale, variant = 'primary', class: className = '' } = Astro.props;
const { t } = useTranslations(locale);

const cvUrl = getCvUrl(locale);
const cvFilename = getCvFilename(locale);

const baseClasses =
  'inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-medium ' +
  'focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ' +
  'transition-all duration-200';

const variantClasses = {
  primary:
    'bg-primary text-white hover:bg-primary-dark hover:-translate-y-0.5 ' +
    'hover:shadow-lg hover:shadow-primary/25',
  outline:
    'border border-border bg-transparent text-foreground ' +
    'hover:border-primary hover:text-primary hover:-translate-y-0.5',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<a
  href={cvUrl}
  download={cvFilename}
  class={classes}
  aria-label={t.cv.ariaLabel}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" y1="15" x2="12" y2="3"></line>
  </svg>

  <span>{t.cv.download}</span>
</a>