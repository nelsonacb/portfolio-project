---
import { Image } from 'astro:assets';
import { aboutPhoto } from '../../data/contact';
import DownloadCV from '../DownloadCV.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);

const stats = [
  { value: '3+', label: t.about.stats.experience },
  { value: '20+', label: t.about.stats.projects },
  { value: '15+', label: t.about.stats.technologies },
];
---

<section id="about" class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-3">{t.about.title}</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">{t.about.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-12 items-start">
      <div class="relative mx-auto md:mx-0 max-w-70 w-full">
        <div class="absolute inset-0 rounded-2xl bg-primary/20 translate-x-3 translate-y-3 -z-10" aria-hidden="true"></div>
        <div class="rounded-2xl overflow-hidden border border-border/50 shadow-lg shadow-primary/5">
          <Image
            src={aboutPhoto}
            alt={t.about.photoAlt}
            widths={[280, 420, 560]}
            sizes="(max-width: 768px) 280px, 280px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-4/5"
          />
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="space-y-4 text-muted-foreground leading-relaxed">
          <p set:html={t.about.bio1}></p>
          <p set:html={t.about.bio2}></p>
        </div>

        <ul class="grid sm:grid-cols-2 gap-3 pt-2">
          {
            [t.about.highlight1, t.about.highlight2, t.about.highlight3, t.about.highlight4].map(
              (item) => (
                <li class="flex items-start gap-2 text-sm">
                  <span
                    class="shrink-0 mt-0.5 w-4 h-4 rounded-full bg-primary/15 text-primary flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span>{item}</span>
                </li>
              )
            )
          }
        </ul>

        <div class="grid grid-cols-3 gap-4 mt-4 p-5 rounded-2xl bg-muted border border-border/50">
          {
            stats.map((stat) => (
              <div class="text-center">
                <div class="text-2xl md:text-3xl font-bold text-primary">{stat.value}</div>
                <div class="text-[11px] md:text-xs text-muted-foreground mt-1 leading-tight">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-2">
          <DownloadCV locale={locale} variant="outline" class="w-full sm:w-auto" />
        </div>
      </div>
    </div>
  </div>
</section>