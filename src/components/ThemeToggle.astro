<button
  type="button"
  class="theme-toggle relative inline-flex items-center justify-center w-10 h-10
         rounded-lg bg-muted hover:bg-muted/80
         text-foreground
         focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2
         transition-colors"
  aria-label="Toggle theme"
  aria-pressed="false"
>
  <svg
    class="theme-icon-moon w-5 h-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>

  <svg
    class="theme-icon-sun w-5 h-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<style>
  .theme-icon-moon { display: block; }
  .theme-icon-sun  { display: none; }

  :global(.dark) .theme-icon-moon { display: none; }
  :global(.dark) .theme-icon-sun  { display: block; }
</style>

<script>
 
  function initThemeToggles() {
    const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

    const isDark = document.documentElement.classList.contains('dark');
    toggles.forEach((btn) => btn.setAttribute('aria-pressed', String(isDark)));

    toggles.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const nowDark = document.documentElement.classList.toggle('dark');

        try {
          localStorage.setItem('theme', nowDark ? 'dark' : 'light');
        } catch (_) {}

        document
          .querySelectorAll<HTMLButtonElement>('.theme-toggle')
          .forEach((b) => b.setAttribute('aria-pressed', String(nowDark)));
      });
    });
  }

  initThemeToggles();
</script>